{
  "name": "eidolon-fitness-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/process-hero.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/process-hero.mjs",
    "build": "astro build && node scripts/check-placeholders.mjs && node scripts/check-links.mjs && node scripts/check-island-size.mjs && node scripts/check-seo.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && SHOW_DRAFTS=1 pnpm build && playwright test",
    "perf": "LH_AUDIT=1 SHOW_DRAFTS=1 pnpm build && lhci autorun",
    "screenshots": "node scripts/screenshots-phase16.mjs",
    "food:review": "tsx scripts/food-review.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/preact": "^6.1.5",
    "@astrojs/rss": "^4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^6.4.8",
    "preact": "^11.2.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
