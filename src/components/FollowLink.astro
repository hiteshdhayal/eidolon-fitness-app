---
import { site } from '../config/site';

interface Props {
  variant?: 'primary' | 'secondary' | 'text';
  location: string;
  label?: string;
  size?: 'md' | 'sm';
  class?: string;
}

const {
  variant = 'secondary',
  location,
  label = `Follow @${site.instagramHandle}`,
  size = 'md',
  class: className = '',
} = Astro.props;

const classes = ['follow', `follow-${variant}`, size === 'sm' ? 'follow-sm' : '', className]
  .filter(Boolean)
  .join(' ');

// WCAG 2.5.3: the accessible name must contain the visible label.
const ariaLabel = `${label} — Follow ${site.creatorName} on Instagram (opens in a new tab)`;
---

<a
  class={classes}
  href={site.instagramUrl}
  target="_blank"
  rel="noopener"
  aria-label={ariaLabel}
  data-umami-event="follow_click"
  data-umami-event-location={location}
>
  <svg
    class="follow-glyph"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5ZM12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 1 0 0-7ZM17.5 6.5h.01"></path>
  </svg>
  <span>{label}</span>
</a>

<style>
  .follow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 52px;
    padding-inline: 24px;
    border: 1px solid var(--border-strong);
    border-radius: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 15px;
    line-height: 1;
    text-decoration: none;
    color: var(--text);
    background-color: transparent;
    background-image: linear-gradient(var(--text), var(--text));
    background-repeat: no-repeat;
    background-position: left center;
    background-size: 0% 100%;
    transition:
      background-size 220ms ease-out,
      color 220ms ease-out,
      background-color 180ms ease-out;
    white-space: nowrap;
  }

  .follow-sm {
    height: 44px;
    padding-inline: 16px;
    font-size: 13px;
  }

  .follow-primary {
    height: auto;
    min-height: 52px;
    padding-block: 14px;
    background-color: var(--accent);
    background-image: none;
    border-color: var(--accent);
    color: var(--ice-0);
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 110%;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
    white-space: normal;
  }

  .follow-primary:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
    color: var(--ice-0);
  }

  .follow-secondary:hover {
    background-size: 100% 100%;
    color: var(--bg);
  }

  .follow-text {
    height: auto;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    gap: 6px;
  }

  .follow-text:hover {
    color: var(--text);
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent);
  }

  .follow-glyph {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }

  @media (max-width: 767px) {
    .follow:not(.follow-text) {
      width: 100%;
    }
  }
</style>
