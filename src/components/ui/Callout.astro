---
import Icon from './Icon.astro';

interface Props {
  variant?: 'info' | 'warning' | 'doctor';
  title: string;
  class?: string;
}

const { variant = 'info', title, class: className = '' } = Astro.props;

const icons = {
  info: 'info',
  warning: 'alert-triangle',
  doctor: 'stethoscope',
} as const;
---

<div class={`callout callout-${variant} ${className}`}>
  <Icon name={icons[variant]} size={20} class="callout-icon" />
  <div>
    <p class="callout-title">{title}</p>
    <div class="callout-body">
      <slot />
    </div>
  </div>
</div>

<style>
  .callout {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 16px 16px 20px;
    border-left: 3px solid var(--text);
    background: var(--surface);
  }

  .callout-warning,
  .callout-doctor {
    border-left-color: var(--accent);
  }

  .callout-icon {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .callout-warning .callout-icon,
  .callout-doctor .callout-icon {
    color: var(--accent-text);
  }

  .callout-title {
    font-weight: 600;
    line-height: 1.4;
  }

  .callout-body {
    margin-top: 4px;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-muted);
  }
</style>
