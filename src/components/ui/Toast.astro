---
interface Props {
  message: string;
  actionLabel?: string;
  class?: string;
}

const { message, actionLabel, class: className = '' } = Astro.props;
---

<div class={`toast ${className}`} role="status">
  <p class="small">{message}</p>
  {actionLabel && <span class="eyebrow toast-action">{actionLabel}</span>}
</div>

<style>
  .toast {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    border-left: 3px solid var(--accent);
    background: var(--text);
    color: var(--bg);
  }

  .toast-action {
    flex-shrink: 0;
    padding-bottom: 2px;
    border-bottom: 1px solid currentColor;
  }
</style>
