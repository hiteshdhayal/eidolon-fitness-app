---
type IconName =
  | 'check'
  | 'arrow-right'
  | 'arrow-left'
  | 'alert-triangle'
  | 'info'
  | 'stethoscope'
  | 'menu'
  | 'x'
  | 'play'
  | 'chevron-down'
  | 'minus'
  | 'plus';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 20, class: className = '', label } = Astro.props;

const paths: Record<IconName, string[]> = {
  check: ['M20 6 9 17l-5-5'],
  'arrow-right': ['M5 12h14', 'M12 5l7 7-7 7'],
  'arrow-left': ['m12 19-7-7 7-7', 'M19 12H5'],
  'alert-triangle': [
    'm21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3',
    'M12 9v4',
    'M12 17h.01',
  ],
  info: ['M12 16v-4', 'M12 8h.01'],
  stethoscope: [
    'M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3',
    'M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4',
    'M20 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z',
  ],
  menu: ['M4 6h16', 'M4 12h16', 'M4 18h16'],
  x: ['M18 6 6 18', 'M6 6l12 12'],
  play: ['m6 3 14 9-14 9V3'],
  'chevron-down': ['m6 9 6 6 6-6'],
  minus: ['M5 12h14'],
  plus: ['M5 12h14', 'M12 5v14'],
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
>
  {name === 'info' && <circle cx="12" cy="12" r="10" />}
  {paths[name].map((d) => (
    <path d={d} />
  ))}
</svg>
