---
interface Option {
  value: string;
  label: string;
}

interface Props {
  name: string;
  legend: string;
  options: Option[];
  value?: string;
}

const { name, legend, options, value } = Astro.props;
---

<fieldset class="segmented">
  <legend class="eyebrow mb-2">{legend}</legend>
  <div class="segmented-track">
    {options.map((option) => (
      <label>
        <input type="radio" name={name} value={option.value} checked={value === option.value} />
        <span>{option.label}</span>
      </label>
    ))}
  </div>
</fieldset>

<style>
  .segmented-track {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 0;
    padding: 3px;
    background: var(--surface);
  }

  .segmented label {
    position: relative;
    cursor: pointer;
  }

  .segmented input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .segmented span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 64px;
    min-height: 40px;
    padding-inline: 12px;
    border-radius: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .segmented input:checked + span {
    background: var(--text);
    color: var(--bg);
  }

  .segmented input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
</style>
