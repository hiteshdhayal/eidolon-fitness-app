---
interface Props {
  value: string;
  label: string;
  unit?: string;
  note?: string;
  inverse?: boolean;
  class?: string;
}

const { value, label, unit, note, inverse = false, class: className = '' } = Astro.props;
---

<div class={className}>
  <p class={`signature leading-none ${inverse ? 'text-inverse-text' : 'text-black'}`}>
    <span class="text-[clamp(2rem,1.4rem+2vw,3.25rem)]">{value}</span>
    {unit && (
      <span class="ml-1 font-mono text-sm font-medium normal-case tracking-normal">{unit}</span>
    )}
  </p>
  <p class={`eyebrow mt-3 ${inverse ? 'text-inverse-muted' : 'text-muted'}`}>{label}</p>
  {note && <p class={`small mt-1 ${inverse ? 'text-inverse-muted' : 'text-muted'}`}>{note}</p>}
</div>
