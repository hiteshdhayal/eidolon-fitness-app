---
interface Props {
  id: string;
  label: string;
  placeholder?: string;
  options: string[];
  value?: string;
}

const { id, label, placeholder = 'Search', options, value } = Astro.props;
---

<div>
  <label for={id} class="eyebrow mb-2 block">
    {label}
  </label>
  <div class="relative">
    <input
      id={id}
      name={id}
      type="text"
      list={`${id}-options`}
      placeholder={placeholder}
      value={value}
      autocomplete="off"
      class="field pr-12"
    />
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </div>
  <datalist id={`${id}-options`}>
    {options.map((option) => (
      <option value={option} />
    ))}
  </datalist>
</div>
