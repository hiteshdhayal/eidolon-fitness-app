---
import Icon from './Icon.astro';

interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class={`border-t border-black ${className}`}>
  {items.map((item) => (
    <details class="group border-b border-border">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
        <span class="font-medium">{item.question}</span>
        <Icon
          name="chevron-down"
          size={20}
          class="shrink-0 transition-transform duration-200 ease-out group-open:rotate-180"
        />
      </summary>
      <p class="measure small pb-6 pr-8 text-muted">{item.answer}</p>
    </details>
  ))}
</div>
