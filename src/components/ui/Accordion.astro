---
interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class={`accordion ${className}`}>
  {items.map((item) => (
    <details class="accordion-item">
      <summary>
        <span class="font-medium">{item.question}</span>
        <span class="accordion-mark" aria-hidden="true">
          <span class="mark-plus">+</span>
          <span class="mark-minus">–</span>
        </span>
      </summary>
      <p class="measure small accordion-answer">{item.answer}</p>
    </details>
  ))}
</div>

<style>
  .accordion {
    border-top: 1px solid var(--border-strong);
  }

  .accordion-item {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 52px;
    padding-block: 14px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover .accordion-mark {
    color: var(--accent-text);
  }

  .accordion-mark {
    flex-shrink: 0;
    width: 20px;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    line-height: 1;
    text-align: center;
  }

  .mark-minus {
    display: none;
  }

  .accordion-item[open] .mark-plus {
    display: none;
  }

  .accordion-item[open] .mark-minus {
    display: inline;
  }

  .accordion-answer {
    padding: 0 32px 24px 0;
    color: var(--text-muted);
  }
</style>
