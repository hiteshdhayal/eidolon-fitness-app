---
import Icon from './Icon.astro';

interface Props {
  name: string;
  label: string;
  value?: number;
  min?: number;
  max?: number;
  step?: number;
  unit?: string;
}

const { name, label, value = 0, min = 0, max = 999, step = 1, unit } = Astro.props;
---

<div class="stepper" data-stepper>
  <span class="eyebrow mb-2 block">{label}</span>
  <div class="stepper-track">
    <button type="button" data-step="-1" class="stepper-btn" aria-label={`Decrease ${label}`}>
      <Icon name="minus" size={18} />
    </button>
    <div class="stepper-input">
      <input
        type="number"
        name={name}
        value={value}
        min={min}
        max={max}
        step={step}
        inputmode="decimal"
        aria-label={label}
      />
      {unit && <span class="stepper-unit">{unit}</span>}
    </div>
    <button type="button" data-step="1" class="stepper-btn" aria-label={`Increase ${label}`}>
      <Icon name="plus" size={18} />
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((stepper) => {
    stepper.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-step]');
      if (!button) return;
      const input = stepper.querySelector<HTMLInputElement>('input');
      if (!input) return;
      const step = Number(input.step) || 1;
      const min = input.min === '' ? -Infinity : Number(input.min);
      const max = input.max === '' ? Infinity : Number(input.max);
      const direction = Number(button.dataset.step);
      const next = Math.min(max, Math.max(min, (Number(input.value) || 0) + direction * step));
      input.value = String(Math.round(next * 10) / 10);
      input.dispatchEvent(new Event('input', { bubbles: true }));
    });
  });
</script>

<style>
  .stepper-track {
    display: flex;
    align-items: stretch;
    height: 56px;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--surface);
  }

  .stepper-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    min-height: 44px;
    border: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .stepper-btn:first-child {
    border-right: 1px solid var(--border);
  }

  .stepper-btn:last-child {
    border-left: 1px solid var(--border);
  }

  .stepper-btn:hover {
    background: var(--border);
  }

  .stepper-input {
    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
  }

  .stepper-input input {
    width: 100%;
    height: 100%;
    padding: 0 40px 0 16px;
    border: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 20px;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    outline: none;
  }

  .stepper-input input:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }

  .stepper-unit {
    position: absolute;
    right: 16px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  input[type='number']::-webkit-outer-spin-button,
  input[type='number']::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  input[type='number'] {
    -moz-appearance: textfield;
    appearance: textfield;
  }
</style>
