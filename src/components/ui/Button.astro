---
import Icon from './Icon.astro';

interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary' | 'inverse' | 'inverse-secondary';
  arrow?: boolean;
  full?: boolean;
  class?: string;
  disabled?: boolean;
  ariaLabel?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  arrow = false,
  full = false,
  class: className = '',
  disabled = false,
  ariaLabel,
} = Astro.props;

const variants: Record<string, string> = {
  primary: 'bg-black text-white border-black hover:bg-gray-800 hover:border-gray-800',
  secondary: 'bg-transparent text-black border-black hover:bg-black hover:text-white',
  inverse: 'bg-white text-black border-white hover:bg-gray-300 hover:border-gray-300',
  'inverse-secondary': 'bg-transparent text-white border-white hover:bg-white hover:text-black',
};

const Tag = href ? 'a' : 'button';
const classes = [
  'group inline-flex h-[52px] items-center justify-center gap-2 rounded-[2px] border px-6',
  'font-sans text-[15px] font-semibold leading-none no-underline',
  'transition-colors duration-200 ease-out',
  variants[variant],
  full ? 'w-full md:w-auto' : '',
  disabled ? 'pointer-events-none opacity-40' : '',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<Tag
  class={classes}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  aria-disabled={disabled ? 'true' : undefined}
  aria-label={ariaLabel}
>
  <span>
    <slot />
  </span>
  {arrow && (
    <Icon
      name="arrow-right"
      size={18}
      class="transition-transform duration-200 ease-out motion-safe:group-hover:translate-x-0.5"
    />
  )}
</Tag>
