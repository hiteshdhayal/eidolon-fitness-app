---
import Icon from './Icon.astro';

interface Props {
  type?: 'radio' | 'checkbox';
  name: string;
  value: string;
  label: string;
  sublabel?: string;
  checked?: boolean;
}

const { type = 'radio', name, value, label, sublabel, checked = false } = Astro.props;
---

<label class="option-card">
  <input type={type} name={name} value={value} checked={checked} />
  <span class="option-text">
    <span class="option-label">{label}</span>
    {sublabel && <span class="option-sublabel">{sublabel}</span>}
  </span>
  <span class="option-check" aria-hidden="true">
    <Icon name="check" size={20} />
  </span>
</label>

<style>
  .option-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    min-height: 60px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition:
      background-color 160ms ease-out,
      color 160ms ease-out,
      border-color 160ms ease-out;
  }

  .option-card input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .option-text {
    min-width: 0;
  }

  .option-label {
    display: block;
    font-weight: 500;
    line-height: 1.35;
  }

  .option-sublabel {
    display: block;
    margin-top: 2px;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .option-check {
    opacity: 0;
    flex-shrink: 0;
  }

  .option-card:hover {
    border-color: var(--border-strong);
  }

  .option-card:has(input:checked) {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
    box-shadow: inset 4px 0 0 0 var(--accent);
  }

  .option-card:has(input:checked) .option-sublabel {
    color: var(--bg);
    opacity: 0.75;
  }

  .option-card:has(input:checked) .option-check {
    opacity: 1;
    color: var(--accent);
  }

  .option-card:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
</style>
