---
interface Props {
  number: string;
  eyebrow: string;
  /** Plain title, or use `accent` for one trailing red italic phrase. */
  title: string;
  /** The one red italic accent phrase for the headline. */
  accent?: string;
  intro?: string;
  id?: string;
  rule?: boolean;
  class?: string;
}

const {
  number,
  eyebrow,
  title,
  accent,
  intro,
  id,
  rule = true,
  class: className = '',
} = Astro.props;
---

<header id={id} class={`mb-10 md:mb-14 ${className}`}>
  <p class="eyebrow-row mb-4">
    <span class="speed-bar" aria-hidden="true"></span>
    <span class="eyebrow">
      <span class="section-header-number">{number}</span> — {eyebrow}
    </span>
  </p>
  <div class="grid gap-6 md:grid-cols-12 md:gap-6">
    <h2 class="md:col-span-6">
      {title}
      {accent && (
        <Fragment>
          {' '}
          <em class="accent-italic">{accent}</em>
        </Fragment>
      )}
    </h2>
    {intro && <p class="measure text-muted md:col-span-5 md:col-start-8 md:pt-2">{intro}</p>}
  </div>
  {rule && <hr class="rule-strong mt-8 md:mt-10" />}
</header>
