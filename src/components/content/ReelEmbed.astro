---
import { Picture } from 'astro:assets';

interface Props {
  instagramUrl: string;
  title: string;
  slug: string;
  thumbnail?: ImageMetadata;
}

const { instagramUrl, title, slug, thumbnail } = Astro.props;
---

<div class="reel-embed" data-reel-embed data-url={instagramUrl} data-slug={slug}>
  <div class="reel-media" data-reel-facade>
    {thumbnail ? (
      <Picture
        src={thumbnail}
        formats={['avif', 'webp']}
        widths={[240, 360, 480, 720]}
        sizes="(min-width: 768px) 360px, 90vw"
        alt={title}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="thumb-placeholder">THUMBNAIL COMING</span>
    )}

    <button
      type="button"
      class="reel-play"
      data-reel-play
      aria-label={`Play reel: ${title}`}
      data-umami-event="reel_open"
      data-umami-event-reel={slug}
      hidden
    >
      <svg
        width="26"
        height="26"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M7 4.5v15l13-7.5-13-7.5Z"></path>
      </svg>
    </button>
  </div>

  <a
    class="reel-link"
    href={instagramUrl}
    target="_blank"
    rel="noopener"
    data-umami-event="reel_open"
  >
    Watch on Instagram ↗
  </a>
</div>

<script>
  // Load Instagram's embed only after a tap, and only once. Under 1 KB.
  document.querySelectorAll<HTMLElement>('[data-reel-embed]').forEach((root) => {
    const play = root.querySelector<HTMLButtonElement>('[data-reel-play]');
    if (!play) return;
    play.hidden = false;
    play.addEventListener('click', () => {
      const url = root.getAttribute('data-url') ?? '';
      const facade = root.querySelector<HTMLElement>('[data-reel-facade]');
      if (!facade) return;
      const block = document.createElement('blockquote');
      block.className = 'instagram-media';
      block.setAttribute('data-instgrm-permalink', url);
      block.setAttribute('data-instgrm-version', '14');
      facade.replaceWith(block);

      const process = () => {
        const scope = window as unknown as { instgrm?: { Embeds?: { process(): void } } };
        scope.instgrm?.Embeds?.process();
      };
      if (!document.querySelector('script[data-instagram-embed]')) {
        const script = document.createElement('script');
        script.src = 'https://www.instagram.com/embed.js';
        script.async = true;
        script.setAttribute('data-instagram-embed', '');
        script.addEventListener('load', process);
        document.body.appendChild(script);
      } else {
        process();
      }
    });
  });
</script>

<style>
  .reel-embed {
    max-width: 360px;
  }

  .reel-media {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: var(--obsidian-900);
  }

  .reel-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }

  .reel-play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 2px solid var(--ice-50);
    border-radius: 50%;
    background: rgba(6, 6, 7, 0.45);
    color: var(--ice-50);
    cursor: pointer;
  }

  .reel-play[hidden] {
    display: none !important;
  }

  .reel-play:hover {
    background: rgba(225, 6, 0, 0.9);
    border-color: var(--accent);
  }

  .reel-play:focus-visible {
    outline: 2px solid var(--red-400);
    outline-offset: 3px;
  }

  .reel-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .reel-link:hover {
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent);
  }
</style>
