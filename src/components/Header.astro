---
import { site } from '../config/site';
import Wordmark from './ui/Wordmark.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
---

<header class="border-b border-black bg-bg">
  <div class="container flex h-[72px] items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label={`${site.brandName} home`}>
      <Wordmark />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class="text-[15px] font-medium text-black hover:underline hover:decoration-1 hover:underline-offset-4"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:block">
      <Button
        href={site.instagramUrl}
        variant="secondary"
        class="h-11 px-5 text-sm"
        ariaLabel={`Follow on Instagram, @${site.instagramHandle}`}
      >
        Follow
      </Button>
    </div>

    <button
      type="button"
      popovertarget="mobile-menu"
      class="flex h-11 items-center gap-2 md:hidden"
      aria-label="Open menu"
    >
      <Icon name="menu" size={20} />
      <span class="eyebrow">Menu</span>
    </button>
  </div>

  <div id="mobile-menu" popover class="mobile-menu" aria-label="Site menu">
    <div class="container flex h-[72px] items-center justify-between">
      <Wordmark class="text-white" />
      <button
        type="button"
        popovertarget="mobile-menu"
        popovertargetaction="hide"
        class="flex h-11 items-center gap-2 text-white"
        aria-label="Close menu"
      >
        <span class="eyebrow">Close</span>
        <Icon name="x" size={20} />
      </button>
    </div>
    <nav class="container mt-10 flex flex-col" aria-label="Mobile">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class="border-b border-gray-800 py-5 font-display text-[clamp(2rem,6vw,2.75rem)] font-extrabold leading-none tracking-tight text-white"
        >
          {item.label}
        </a>
      ))}
      <a
        href={site.instagramUrl}
        class="mt-10 inline-flex h-[52px] w-full items-center justify-center border border-white px-6 text-[15px] font-semibold text-white"
      >
        Follow @{site.instagramHandle}
      </a>
      <p class="small mt-8 text-inverse-muted">{site.disclaimer}</p>
    </nav>
  </div>
</header>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    border: 0;
    padding: 0;
    background: var(--color-black);
    color: var(--color-white);
    overflow-y: auto;
  }

  .mobile-menu::backdrop {
    background: var(--color-black);
  }
</style>
