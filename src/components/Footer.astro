---
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import Wordmark from './ui/Wordmark.astro';
import FollowLink from './FollowLink.astro';
import { publishedOnly } from '../lib/content/published';

const year = new Date().getFullYear();

const contactLink = site.contactEmail
  ? { href: `mailto:${site.contactEmail}`, label: 'Contact' }
  : { href: site.instagramUrl, label: 'Contact (Instagram DM)' };

// "My picks" only exists once there's something to show there.
const hasPicks = publishedOnly(await getCollection('articles')).some(
  (entry) => entry.data.hasAffiliateLinks,
);

interface FooterLink {
  label: string;
  href?: string;
  /** Rendered as a FollowLink instead of a plain <a>. */
  follow?: boolean;
}

const columns: { heading: string; links: FooterLink[] }[] = [
  {
    heading: 'Plan',
    links: [
      { label: 'Diet plan', href: '/plan/' },
      { label: 'My plan', href: '/my-plan/' },
      { label: 'Tools', href: '/tools/' },
    ],
  },
  {
    heading: 'Learn',
    links: [
      { label: 'Exercises', href: '/learn/' },
      { label: 'Workouts', href: '/workouts/' },
      { label: 'Guides', href: '/learn/guides/' },
    ],
  },
  {
    heading: 'Content',
    links: [
      { label: 'Reels', href: '/reels/' },
      { label: 'Articles', href: '/articles/' },
      ...(hasPicks ? [{ label: 'My picks', href: '/articles/picks/' }] : []),
    ],
  },
  {
    heading: 'Site',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Instagram', follow: true },
      { label: contactLink.label, href: contactLink.href },
      { label: 'Links', href: '/links/' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { label: 'Disclaimer', href: '/disclaimer/' },
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Affiliate disclosure', href: '/affiliate-disclosure/' },
      { label: 'Terms', href: '/terms/' },
    ],
  },
];
---

<footer class="site-footer" data-surface="obsidian">
  <div class="container footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" aria-label={`${site.brandName} home`}>
          <Wordmark />
        </a>
        <p class="footer-bio">
          {site.bio} Built by {site.creatorName}.
        </p>
        <FollowLink variant="secondary" location="footer" />
      </div>

      <div class="footer-columns">
        {columns.map((column) => (
          <nav aria-label={column.heading}>
            <h2 class="eyebrow footer-heading">{column.heading}</h2>
            <ul class="footer-list">
              {column.links.map((link) => (
                <li>
                  {link.follow ? (
                    <FollowLink
                      variant="text"
                      location="footer-instagram"
                      label={link.label}
                    />
                  ) : (
                    <a href={link.href} class="footer-link">
                      {link.label}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <div class="footer-legal">
      <p class="small">
        {site.disclaimer}{' '}
        <a class="footer-inline-link" href="/disclaimer/">
          Read the disclaimer →
        </a>
      </p>
      <p class="small">
        Some article links are affiliate links. If you buy through them I may earn a commission, at
        no extra cost to you.
        <a class="footer-inline-link" href="/affiliate-disclosure/">
          Affiliate disclosure →
        </a>
      </p>
      <p class="label footer-copy">
        © {year} {site.creatorName} · {site.domain}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--obsidian-950);
    color: var(--ice-50);
  }

  .footer-inner {
    padding-block: 64px 40px;
  }

  .footer-grid {
    display: grid;
    gap: 48px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .footer-bio {
    max-width: 34ch;
    font-size: 0.875rem;
    color: var(--steel-400);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  .footer-heading {
    margin-bottom: 16px;
    color: var(--steel-400);
    font-weight: 500;
  }

  .footer-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-link {
    position: relative;
    display: inline-block;
    padding-bottom: 2px;
    font-size: 0.875rem;
    color: var(--ice-200);
    text-decoration: none;
    background-image: linear-gradient(var(--red-500), var(--red-500));
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 0% 1px;
    transition:
      background-size 180ms ease-out,
      color 160ms ease-out;
  }

  .footer-link:hover {
    color: var(--ice-50);
    background-size: 100% 1px;
  }

  .footer-legal {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--obsidian-600);
    color: var(--steel-400);
  }

  .footer-copy {
    padding-top: 6px;
    color: var(--steel-400);
  }

  .footer-inline-link {
    color: var(--steel-400);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .footer-inline-link:hover {
    color: var(--ice-50);
    text-decoration-color: var(--red-500);
  }

  :global(.footer-list .follow-text) {
    color: var(--ice-200);
    font-size: 0.875rem;
  }

  :global(.footer-list .follow-text:hover) {
    color: var(--ice-50);
  }

  @media (max-width: 767px) {
    .footer-inner {
      padding-bottom: calc(40px + 72px);
    }
  }

  @media (min-width: 768px) {
    .footer-inner {
      padding-block: 80px 40px;
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 4fr 8fr;
      gap: 24px;
    }

    .footer-columns {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 24px;
    }
  }
</style>
