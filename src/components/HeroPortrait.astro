---
import { Picture } from 'astro:assets';

interface HeroImageModule {
  default: ImageMetadata;
}

const modules = import.meta.glob<HeroImageModule>('../assets/hero/processed/*.{png,jpg}', {
  eager: true,
});

const cutout = modules['../assets/hero/processed/hero-cutout.png']?.default;
const scene = modules['../assets/hero/processed/hero-scene.jpg']?.default;
const image = cutout ?? scene;
const variant = cutout ? 'cutout' : scene ? 'scene' : null;

if (!image && import.meta.env.DEV) {
  console.warn(
    '[HeroPortrait] No hero image found. Add src/assets/hero/hero.png (cut-out) or hero.jpg (with background), then restart the dev server.',
  );
}

interface Props {
  /** CSS object-position for the photo, so the face is never covered. */
  position?: string;
  class?: string;
}

const { position = 'center top', class: className = '' } = Astro.props;
---

{image && variant && (
  <div
    class={`portrait portrait-${variant} ${className}`}
    style={`--portrait-position: ${position}`}
  >
    <Picture
      src={image}
      formats={['avif', 'webp']}
      widths={[480, 768, 1080, 1440, 1920]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      alt="Hitesh Dhayal, creator of Eidolon"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      quality={72}
    />
  </div>
)}

<style>
  .portrait {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-position: var(--portrait-position);
    filter: saturate(0.92);
  }

  .portrait-cutout :global(img) {
    object-fit: contain;
    object-position: var(--portrait-position);
    -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 12%);
    mask-image: linear-gradient(to top, transparent 0%, #000 12%);
  }

  .portrait-scene :global(img) {
    object-fit: cover;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, #000 38%),
      linear-gradient(to top, transparent 0%, #000 28%),
      linear-gradient(to left, transparent 0%, #000 6%),
      linear-gradient(to bottom, transparent 0%, #000 6%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, #000 38%),
      linear-gradient(to top, transparent 0%, #000 28%),
      linear-gradient(to left, transparent 0%, #000 6%),
      linear-gradient(to bottom, transparent 0%, #000 6%);
    mask-composite: intersect;
  }

  @media (max-width: 767px) {
    .portrait-scene :global(img) {
      -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 40%);
      mask-image: linear-gradient(to top, transparent 0%, #000 40%);
    }
  }
</style>
