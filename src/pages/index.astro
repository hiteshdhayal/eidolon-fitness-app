---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import FollowLink from '../components/FollowLink.astro';
import HeroStage from '../components/HeroStage.astro';
import KineticBand from '../components/KineticBand.astro';
import FinalCta from '../components/content/FinalCta.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import KitchenSection from '../components/home/KitchenSection.astro';
import AboutMeSection from '../components/home/AboutMeSection.astro';
import FaqSection from '../components/home/FaqSection.astro';
import ReelsTeaserSection from '../components/home/ReelsTeaserSection.astro';
import LearnTeaserSection from '../components/home/LearnTeaserSection.astro';
import ArticlesTeaserSection from '../components/home/ArticlesTeaserSection.astro';
import { getCollection } from 'astro:content';
import { publishedOnly } from '../lib/content/published';
import { HOME_FAQ } from '../lib/home/faq';
import { defaultTitle, site } from '../config/site';
import { getHeroSlides, heroSizes } from '../lib/hero-slides';
import '../styles/content.css';

const { slides: heroSlides } = getHeroSlides();
const heroPreload = heroSlides[0];

// Sections 5–7 (reels, learn, articles) only render when they have published
// content. Numbers and obsidian/ice surfaces are assigned dynamically so a
// hidden section leaves no gap in the numbering and no two visible sections
// ever share a surface (spec Phase 6 Part A).
const reels = publishedOnly(await getCollection('reels')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const articleEntries = publishedOnly(await getCollection('articles'));
const guides = articleEntries.filter((entry) => entry.data.kind === 'guide');
const articles = articleEntries
  .filter((entry) => entry.data.kind === 'article')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const homeSections = [
  { key: 'kitchen', visible: true },
  { key: 'reels', visible: reels.length > 0 },
  { key: 'learn', visible: guides.length > 0 },
  { key: 'articles', visible: articles.length > 0 },
  { key: 'about', visible: true },
  { key: 'faq', visible: true },
] as const;

type Surface = 'obsidian' | 'ice';
const number: Partial<Record<(typeof homeSections)[number]['key'], string>> = {};
const surface: Partial<Record<(typeof homeSections)[number]['key'], Surface>> = {};
let n = 2; // "01 — How it works" already used above
let nextSurface: Surface = 'obsidian'; // the section right after How it works (ice)
for (const section of homeSections) {
  if (!section.visible) continue;
  number[section.key] = String(n).padStart(2, '0');
  surface[section.key] = nextSurface;
  nextSurface = nextSurface === 'obsidian' ? 'ice' : 'obsidian';
  n += 1;
}

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.creatorName,
  url: site.siteUrl,
  sameAs: [site.instagramUrl],
  ...(site.credentials ? { jobTitle: site.credentials } : {}),
};
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.brandName,
  url: site.siteUrl,
};
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQ.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const steps = [
  {
    number: '01',
    title: 'Answer a few taps',
    text: 'Goal, height, weight, food you eat, and any health conditions. About two minutes. No sign-up.',
  },
  {
    number: '02',
    title: "Get a 7-day plan from your region's food",
    text: 'Bajra roti or puttu, kadhi or sambar — portions built around what you already cook at home.',
  },
  {
    number: '03',
    title: 'Track progress and swap meals',
    text: 'Swap any meal, shuffle a day, and log your weight. Everything stays on your phone.',
  },
];
---

<BaseLayout
  title={defaultTitle}
  description="A free 7-day Indian diet plan from your state's kitchen. Veg, non-veg, Jain or vegan. No sign-up, no protein shakes required."
  overlayHeader
  flushTop
  hideStickyCta
>
  <Fragment slot="head">
    {heroPreload && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={heroPreload.avifSrcset}
        imagesizes={heroSizes}
        fetchpriority="high"
      />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <section class="hero" data-surface="obsidian">
    <div id="header-sentinel" class="header-sentinel" aria-hidden="true"></div>

    <div class="container hero-inner">
      <span class="hero-word text-outline" aria-hidden="true">
        EIDOLON
      </span>

      <div class="hero-stage-col">
        <HeroStage />
      </div>

      <div class="hero-scrim" aria-hidden="true"></div>

      <div class="hero-copy">
        <p class="eyebrow-row">
          <span class="speed-bar" aria-hidden="true"></span>
          <span class="eyebrow">Free · 2 minutes · No sign-up</span>
        </p>

        <h1 class="display hero-title">
          <span class="reveal-line">
            <span>A diet plan</span>
          </span>
          <span class="reveal-line">
            <span>built on the</span>
          </span>
          <span class="reveal-line">
            <span>food you</span>
          </span>
          <span class="reveal-line">
            <span>
              <em class="accent-italic">already eat.</em>
            </span>
          </span>
        </h1>

        <p class="hero-sub hero-fade">
          A few taps. A 7-day plan from your state's kitchen — veg, non-veg, Jain or vegan. No
          shakes required.
        </p>

        <div class="hero-ctas hero-fade">
          <Button href="/plan/" arrow planCta="default">
            Build my plan
          </Button>
          <FollowLink variant="secondary" location="hero" />
        </div>

        <p class="hero-proof hero-fade">
          VEG · NON-VEG · EGGETARIAN · JAIN · VEGAN — ALL 36 STATES &amp; UTS
        </p>
      </div>
    </div>
  </section>

  <KineticBand />

  <section class="section how" data-surface="ice">
    <div class="container section-reveal">
      <SectionHeader
        number="01"
        eyebrow="How it works"
        title="Three steps. Your week is sorted."
        intro="The plan comes from a food database built around Indian home cooking, not a generic template."
        rule={false}
      />

      <ol class="steps">
        {steps.map((step) => (
          <li class="step-row">
            <span class="section-number" aria-hidden="true">
              {step.number}
            </span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-text">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <KitchenSection number={number.kitchen!} surface={surface.kitchen!} />

  {reels.length > 0 && (
    <ReelsTeaserSection number={number.reels!} surface={surface.reels!} reels={reels} />
  )}

  {guides.length > 0 && (
    <LearnTeaserSection number={number.learn!} surface={surface.learn!} guides={guides} />
  )}

  {articles.length > 0 && (
    <ArticlesTeaserSection
      number={number.articles!}
      surface={surface.articles!}
      articles={articles}
    />
  )}

  <AboutMeSection number={number.about!} surface={surface.about!} />

  <FaqSection number={number.faq!} surface={surface.faq!} />

  <FinalCta titleBefore="Your plan is" accent="2 minutes" titleAfter="away." location="final-cta" />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: clip;
    min-height: 100svh;
  }

  .header-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 80px;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    gap: 24px;
    min-height: 100svh;
    padding-top: var(--header-h);
  }

  .hero-word {
    position: absolute;
    left: 50%;
    bottom: 8%;
    z-index: 0;
    width: 100vw;
    transform: translateX(-50%);
    text-align: center;
    pointer-events: none;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 125%;
    font-size: 17vw;
    line-height: 0.75;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .hero-stage-col {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: 50%;
    padding-top: var(--header-h);
    padding-bottom: 64px;
  }

  .hero-scrim {
    position: absolute;
    inset-block: 0;
    left: 0;
    z-index: 2;
    width: 68%;
    background: linear-gradient(90deg, var(--obsidian-900) 30%, transparent 65%);
    pointer-events: none;
  }

  .hero-copy {
    position: relative;
    z-index: 6;
    grid-column: 1 / 9;
    padding-block: 72px 64px;
    transform: translateY(16px);
    pointer-events: none;
  }

  /* Astro scoping would require the anchor to carry this component's scope
     attribute, which the Button/FollowLink components do not. :global() keeps
     the hero CTAs clickable. */
  .hero-copy :global(a),
  .hero-copy :global(button) {
    pointer-events: auto;
  }

  .hero-title {
    max-width: 16ch;
    margin-top: 24px;
    font-size: clamp(2.75rem, 1rem + 4.8vw, 5rem);
  }

  .reveal-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .reveal-line > span {
    display: block;
    animation: rise 650ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .reveal-line:nth-child(2) > span {
    animation-delay: 90ms;
  }

  .reveal-line:nth-child(3) > span {
    animation-delay: 180ms;
  }

  .hero-sub {
    max-width: 44ch;
    margin-top: 24px;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-muted);
    animation-delay: 420ms;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 32px;
    animation-delay: 480ms;
  }

  .hero-proof {
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--steel-400);
    animation-delay: 540ms;
  }

  .hero-fade {
    animation: fade-up 500ms ease-out both;
  }

  .how {
    position: relative;
    z-index: 1;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border-strong);
  }

  .step-row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
    align-items: start;
    padding-block: 40px;
    border-bottom: 1px solid var(--border);
    transition: border-color 160ms ease-out;
  }

  .step-row:last-child {
    border-bottom: 0;
  }

  .step-row:hover {
    border-color: var(--border-strong);
  }

  .step-row > .section-number {
    grid-column: 1 / 3;
  }

  .step-title {
    grid-column: 3 / 8;
    font-size: 1.375rem;
    font-stretch: 105%;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .step-text {
    grid-column: 8 / 13;
    max-width: 46ch;
    color: var(--text-muted);
  }

  @media (min-width: 768px) {
    .hero {
      height: min(100svh, 940px);
      min-height: 720px;
    }

    .hero-inner {
      min-height: 100%;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .hero-copy {
      grid-column: 1 / 7;
    }

    .hero-title {
      max-width: 14ch;
      font-size: 2.5rem;
    }

    .hero-stage-col {
      width: 48%;
      padding-bottom: 88px;
    }
  }

  @media (max-width: 767px) {
    .hero-inner {
      display: block;
      min-height: 100svh;
      padding-top: 0;
    }

    /* No slides yet: keep the hero compact instead of reserving empty media space. */
    .hero:not(:has(.stage)) {
      min-height: auto;
    }

    .hero:not(:has(.stage)) .hero-inner {
      min-height: auto;
      padding-block: calc(var(--header-h) + 40px) 64px;
    }

    .hero:not(:has(.stage)) .hero-copy {
      padding-top: 0;
    }

    .hero-stage-col {
      position: static;
      width: 100%;
      height: auto;
      padding-top: 0;
      padding-bottom: 0;
    }

    .hero-word,
    .hero-scrim {
      display: none;
    }

    .hero-copy {
      padding-top: 16px;
      padding-bottom: 56px;
      transform: none;
    }

    .hero-copy > .eyebrow-row {
      display: none;
    }

    .hero-title {
      max-width: 12ch;
      font-size: 2.25rem;
      font-stretch: 100%;
    }

    .hero-ctas {
      flex-direction: column;
      margin-top: 24px;
    }

    .hero-ctas > :global(*) {
      width: 100%;
    }

    .step-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .step-row > .section-number,
    .step-title,
    .step-text {
      grid-column: 1 / -1;
    }

    .step-row > .section-number {
      margin-bottom: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-line > span,
    .hero-fade {
      animation: none !important;
    }
  }
</style>
