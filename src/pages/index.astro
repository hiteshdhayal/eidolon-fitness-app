---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import PlaceholderMedia from '../components/ui/PlaceholderMedia.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { site } from '../config/site';

const steps = [
  {
    number: '01',
    title: 'Answer a few taps',
    text: 'Goal, height, weight, food you eat, and any health conditions. About two minutes. No sign-up.',
  },
  {
    number: '02',
    title: "Get a 7-day plan from your region's food",
    text: 'Bajra roti or puttu, kadhi or sambar — portions built around what you already cook at home.',
  },
  {
    number: '03',
    title: 'Track progress and swap meals',
    text: 'Swap any meal, shuffle a day, and log your weight. Everything stays on your phone.',
  },
];
---

<BaseLayout
  title="Indian diet plan, built on your food"
  description="Free 7-day Indian diet plans from your state's kitchen. Veg, non-veg, Jain or vegan. No sign-up, no protein shakes required."
>
  <section class="section pt-14 md:pt-20">
    <div class="container">
      <div class="grid gap-12 md:grid-cols-12 md:items-end md:gap-6">
        <div class="md:col-span-7">
          <p class="eyebrow mb-6">Free · 2 minutes · No sign-up</p>
          <h1 class="display">A diet plan built on the food you already eat.</h1>
          <p class="measure mt-6 text-lg text-muted">
            A few taps. A 7-day plan from your state's kitchen — veg, non-veg, Jain or vegan. No
            shakes required.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <Button href="/plan/" arrow full class="sm:w-auto">
              Build my plan
            </Button>
            <Button href={site.instagramUrl} variant="secondary" full class="sm:w-auto">
              Follow @{site.instagramHandle}
            </Button>
          </div>
          <p class="small mt-6 max-w-[46ch] text-muted">
            General education, not medical advice. Your answers never leave your phone.
          </p>
        </div>
        <div class="md:col-span-5 md:col-start-8">
          <PlaceholderMedia label="PHOTO — portrait, gym, 4:5" ratio="4:5" />
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container">
      <SectionHeader
        number="01"
        eyebrow="How it works"
        title="Three steps, then your week is sorted."
        intro="The plan comes from a food database built around Indian home cooking, not a generic template."
      />

      <ol class="border-t border-black">
        {steps.map((step) => (
          <li class="grid gap-4 border-b border-border py-8 md:grid-cols-12 md:gap-6">
            <p class="signature text-[clamp(1.5rem,1.2rem+1vw,2rem)] md:col-span-1">
              {step.number}
            </p>
            <h3 class="md:col-span-5">{step.title}</h3>
            <p class="measure text-muted md:col-span-5 md:col-start-7">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-black text-inverse-text">
    <div class="container py-16 md:py-24">
      <div class="grid gap-8 md:grid-cols-12 md:items-end">
        <div class="md:col-span-7">
          <p class="eyebrow mb-4 text-inverse-muted">Free · No sign-up</p>
          <h2>Your plan is 2 minutes away.</h2>
        </div>
        <div class="md:col-span-4 md:col-start-9">
          <Button href="/plan/" variant="inverse" arrow full>
            Build my plan
          </Button>
          <a
            href={site.instagramUrl}
            class="mt-4 inline-block text-sm text-inverse-text underline decoration-1 underline-offset-4 hover:decoration-2"
          >
            Follow @{site.instagramHandle}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
