---
import { getCollection, render } from 'astro:content';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanView from '../islands/PlanView';
import RelatedReels from '../components/RelatedReels.astro';
import Button from '../components/ui/Button.astro';
import FollowLink from '../components/FollowLink.astro';
import { site } from '../config/site';
import '../styles/plan.css';

const entries = await getCollection('healthNotes');
const container = await AstroContainer.create();
const notes = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    const html = await container.renderToString(Content);
    return {
      id: entry.id,
      title: entry.data.title,
      reviewedBy: entry.data.reviewedBy,
      html,
    };
  }),
);
---

<BaseLayout
  title="Your plan · Eidolon"
  description="Your saved Eidolon diet plan."
  noindex
  hideStickyCta
>
  <PlanView client:load notes={notes} />

  <section class="pv-follow section" data-surface="obsidian">
    <div class="container">
      <span class="pv-follow-rule" aria-hidden="true"></span>

      <p class="eyebrow-row">
        <span class="speed-bar" aria-hidden="true"></span>
        <span class="eyebrow">Stay close</span>
      </p>

      <h2 class="display pv-follow-title">
        New recipes from these plans, <em class="accent-italic">every week.</em>
      </h2>

      <p class="pv-follow-sub">I post recipes and swaps from these plans on Instagram.</p>

      <div class="pv-follow-actions">
        <FollowLink
          variant="primary"
          location="my-plan"
          label={`Follow @${site.instagramHandle}`}
        />
        <Button variant="secondary" class="pv-share">
          Share this site
        </Button>
      </div>
    </div>
  </section>

  <section class="pv-disclaimer-section section" data-surface="ice">
    <div class="container">
      <p class="pv-disclaimer">
        {site.disclaimer} <a href="/disclaimer/">Read the disclaimer →</a>
      </p>
    </div>
  </section>

  <RelatedReels />

  <div class="pv-toast" data-share-toast hidden>
    Link copied
  </div>

  <script>
    // Share the site only. Web Share API first, copy-link fallback.
    try {
      const button = document.querySelector<HTMLButtonElement>('.pv-share');
      const toast = document.querySelector<HTMLElement>('[data-share-toast]');
      button?.addEventListener('click', async () => {
        const url = 'https://eidolon.cloud';
        try {
          if (navigator.share) {
            await navigator.share({ title: 'Eidolon', url });
            return;
          }
          await navigator.clipboard.writeText(url);
          if (toast) {
            toast.hidden = false;
            window.setTimeout(() => {
              toast.hidden = true;
            }, 2500);
          }
        } catch {
          // user cancelled or clipboard blocked
        }
      });
    } catch {
      // ignore — the button stays inert
    }
  </script>
</BaseLayout>

<style is:global>
  @page {
    size: A4;
    margin: 14mm;
  }

  .print-only {
    display: none;
  }

  @media print {
    .site-header,
    footer,
    .sticky-cta,
    .pv-screen,
    .pv-sheet,
    .pv-follow,
    .pv-disclaimer-section,
    .pv-toast {
      display: none !important;
    }

    .print-only {
      display: block !important;
    }

    html,
    body {
      background: #fff !important;
      color: #000 !important;
    }

    * {
      color: #000 !important;
      background: transparent !important;
      border-color: #000 !important;
      box-shadow: none !important;
      font-family: var(--font-mono) !important;
    }

    .print-only h1,
    .print-only h2,
    .print-only h3 {
      font-family: var(--font-display) !important;
    }

    .print-only h2 {
      margin-top: 8px;
      margin-bottom: 6px;
    }

    .print-only ul {
      margin: 4px 0 0;
      padding-left: 18px;
    }

    .pv-print-day {
      break-before: page;
      page-break-before: always;
    }

    .pv-print-day:first-of-type {
      break-before: auto;
      page-break-before: auto;
    }

    .pv-print-tail {
      break-before: page;
      page-break-before: always;
    }
  }
</style>
