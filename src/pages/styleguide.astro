---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
import FollowLink from '../components/FollowLink.astro';
import OptionCard from '../components/ui/OptionCard.astro';
import SegmentedControl from '../components/ui/SegmentedControl.astro';
import SearchSelect from '../components/ui/SearchSelect.astro';
import Stepper from '../components/ui/Stepper.astro';
import Callout from '../components/ui/Callout.astro';
import Accordion from '../components/ui/Accordion.astro';
import StatBlock from '../components/ui/StatBlock.astro';
import Toast from '../components/ui/Toast.astro';
import BottomSheet from '../components/ui/BottomSheet.astro';
import Icon from '../components/ui/Icon.astro';
import { pageTitle } from '../config/site';

const swatches = [
  { name: 'obsidian-950', value: '#060607' },
  { name: 'obsidian-900', value: '#0B0C0E' },
  { name: 'obsidian-800', value: '#131417' },
  { name: 'obsidian-700', value: '#1C1E22' },
  { name: 'obsidian-600', value: '#2A2D33' },
  { name: 'obsidian-500', value: '#3A3E45' },
  { name: 'steel-500', value: '#5E6570' },
  { name: 'steel-400', value: '#8B939D' },
  { name: 'steel-300', value: '#AEB5BE' },
  { name: 'ice-300', value: '#C3CBD3' },
  { name: 'ice-200', value: '#D3DAE1' },
  { name: 'ice-100', value: '#E4E9EE' },
  { name: 'ice-50', value: '#F1F4F7' },
  { name: 'ice-0', value: '#F8FAFB' },
  { name: 'red-700', value: '#9E0B07' },
  { name: 'red-600', value: '#C10A04' },
  { name: 'red-500', value: '#E10600' },
  { name: 'red-400', value: '#FF3B30' },
];

const faqs = [
  {
    question: 'Is it free?',
    answer:
      'Yes. The plan, the tools and the articles are free. Nothing is locked behind a sign-up.',
  },
  {
    question: 'Where is my data stored?',
    answer: 'In your browser, on your phone. Nothing is sent to a server.',
  },
];

const states = ['Haryana', 'Punjab', 'Tamil Nadu', 'Kerala', 'West Bengal', 'Gujarat'];
---

<BaseLayout
  title={pageTitle('Styleguide')}
  description="Internal component gallery for the Eidolon design system."
  noindex
  hideStickyCta
>
  <section class="section intro" data-surface="ice">
    <div class="container">
      <p class="eyebrow-row mb-4">
        <span class="speed-bar" aria-hidden="true"></span>
        <span class="eyebrow">Internal · noindex</span>
      </p>
      <h1 class="display">Styleguide</h1>
      <p class="measure mt-6 text-muted">
        Obsidian, ice and racing red. Components are shown on both surfaces; every colour comes from
        a token.
      </p>
      <hr class="rule-strong mt-10" />
    </div>
  </section>

  <section class="section" data-surface="ice">
    <div class="container">
      <SectionHeader
        number="01"
        eyebrow="Type"
        title="Typography"
        intro="Archivo for display and headings, IBM Plex Sans for body, IBM Plex Mono for labels."
      />

      <div class="stack">
        <div>
          <p class="eyebrow mb-3">Display · italic accent</p>
          <p class="display">
            Food you <em class="accent-italic">already eat.</em>
          </p>
        </div>
        <div>
          <p class="eyebrow mb-3">Heading 1</p>
          <p class="type-h1">Your state's kitchen</p>
        </div>
        <div>
          <p class="eyebrow mb-3">Heading 2</p>
          <p class="type-h2">Protein without shakes</p>
        </div>
        <div>
          <p class="eyebrow mb-3">Heading 3</p>
          <p class="type-h3">How to find your step count</p>
        </div>
        <div>
          <p class="eyebrow mb-3">Body · 17px</p>
          <p class="measure">
            Dal, roti, curd and a little ghee is a complete meal. The plan keeps your usual food and
            adjusts the portions, so you are not cooking a second dinner for yourself.
          </p>
        </div>
        <div>
          <p class="eyebrow mb-3">Small · 14px</p>
          <p class="small measure text-muted">
            Approx. values. Cooked weights are estimates; your portion may vary slightly.
          </p>
        </div>
        <div>
          <p class="eyebrow mb-3">Eyebrow, label and speed bar</p>
          <p class="eyebrow-row">
            <span class="speed-bar" aria-hidden="true"></span>
            <span class="eyebrow">03 — Food</span>
          </p>
          <p class="label mt-2 text-muted">1 katori · 150 ml</p>
        </div>
        <div>
          <p class="eyebrow mb-3">Section number · outlined, fills red on hover</p>
          <p class="section-number" aria-hidden="true">
            01
          </p>
        </div>
        <div>
          <p class="eyebrow mb-3">Text link</p>
          <p>
            <a href="#" class="text-link">
              Read the full article
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" data-surface="ice">
    <div class="container">
      <SectionHeader
        number="02"
        eyebrow="Color"
        title="Obsidian, ice, racing red"
        intro="Red is the accent, never body text and never a background wash."
      />

      <ul class="swatches">
        {swatches.map((swatch) => (
          <li class="swatch">
            <div class="swatch-chip" style={`background: ${swatch.value}`} aria-hidden="true" />
            <p class="label mt-2">{swatch.name}</p>
            <p class="label swatch-hex">{swatch.value}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" data-surface="ice">
    <div class="container">
      <SectionHeader
        number="03"
        eyebrow="Actions"
        title="Buttons and links"
        intro="One red primary action per screen. Secondary buttons wipe from the left."
      />

      <p class="eyebrow mb-4">On ice</p>
      <div class="actions-row">
        <Button href="#">Primary</Button>
        <Button href="#" variant="secondary">
          Secondary
        </Button>
        <Button href="#" arrow>
          With arrow
        </Button>
        <Button type="button" variant="secondary" disabled>
          Disabled
        </Button>
      </div>

      <div class="actions-row mt-6">
        <FollowLink variant="primary" location="styleguide-primary" />
        <FollowLink variant="secondary" location="styleguide-secondary" />
        <FollowLink variant="text" location="styleguide-text" />
      </div>
    </div>
  </section>

  <section class="section" data-surface="obsidian">
    <div class="container">
      <p class="eyebrow-row mb-6">
        <span class="speed-bar" aria-hidden="true"></span>
        <span class="eyebrow">On obsidian</span>
      </p>
      <div class="actions-row">
        <Button href="#">Primary</Button>
        <Button href="#" variant="secondary">
          Secondary
        </Button>
        <Button href="#" arrow>
          With arrow
        </Button>
      </div>
      <div class="actions-row mt-6">
        <FollowLink variant="primary" location="styleguide-dark-primary" />
        <FollowLink variant="secondary" location="styleguide-dark-secondary" />
        <FollowLink variant="text" location="styleguide-dark-text" />
      </div>
    </div>
  </section>

  <section class="section" data-surface="ice">
    <div class="container">
      <SectionHeader
        number="04"
        eyebrow="Form"
        title="Questionnaire controls"
        intro="Real inputs, 44px targets, red focus rings."
      />

      <div class="two-col">
        <div class="stack-sm">
          <p class="eyebrow">Option cards · radio</p>
          <OptionCard name="goal" value="lose" label="Lose fat" checked />
          <OptionCard
            name="goal"
            value="muscle"
            label="Build muscle"
            sublabel="Keep most meals the same, add a little protein."
          />
          <OptionCard name="goal" value="healthy" label="Eat healthier and get fitter" />
        </div>

        <div class="stack">
          <div>
            <p class="eyebrow mb-2">Option cards · checkbox</p>
            <OptionCard
              type="checkbox"
              name="conditions"
              value="pcos"
              label="PCOS / PCOD"
              checked
            />
            <OptionCard type="checkbox" name="conditions" value="bp" label="High blood pressure" />
          </div>

          <div>
            <label for="weight-demo" class="eyebrow mb-2 block">
              Weight
            </label>
            <div class="field-wrap">
              <input id="weight-demo" class="field" type="text" inputmode="decimal" value="72.4" />
              <span class="field-unit">KG</span>
            </div>
          </div>

          <SegmentedControl
            name="height-unit-demo"
            legend="Height unit"
            value="ft"
            options={[
              { value: 'cm', label: 'CM' },
              { value: 'ft', label: 'FT · IN' },
            ]}
          />

          <SearchSelect
            id="state-demo"
            label="State"
            placeholder="Search states"
            options={states}
          />

          <Stepper name="age-demo" label="Age" value={28} min={13} max={90} unit="YRS" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" data-surface="obsidian">
    <div class="container">
      <p class="eyebrow-row mb-6">
        <span class="speed-bar" aria-hidden="true"></span>
        <span class="eyebrow">Form controls on obsidian</span>
      </p>
      <div class="two-col">
        <div class="stack-sm">
          <OptionCard name="goal-dark" value="lose" label="Lose fat" checked />
          <OptionCard name="goal-dark" value="muscle" label="Build muscle" />
        </div>
        <div class="stack">
          <div>
            <label for="weight-dark" class="eyebrow mb-2 block">
              Weight
            </label>
            <div class="field-wrap">
              <input id="weight-dark" class="field" type="text" inputmode="decimal" value="72.4" />
              <span class="field-unit">KG</span>
            </div>
          </div>
          <SegmentedControl
            name="height-unit-dark"
            legend="Height unit"
            value="cm"
            options={[
              { value: 'cm', label: 'CM' },
              { value: 'ft', label: 'FT · IN' },
            ]}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section" data-surface="ice">
    <div class="container">
      <SectionHeader
        number="05"
        eyebrow="Feedback"
        title="Callouts and toasts"
        intro="The bar turns red only when the message is a warning or a medical note."
      />

      <div class="callout-grid">
        <Callout title="Your plan is saved on this phone" variant="info">
          Nothing is sent to a server. Clearing your browser data will remove it.
        </Callout>
        <Callout title="Low sugar risk with some medicines" variant="warning">
          Insulin and glimepiride can cause low sugar when you eat less. Talk to your doctor before
          cutting calories.
        </Callout>
        <Callout title="Kidney disease needs medical targets" variant="doctor">
          Protein, potassium and phosphorus should be set by your doctor or dietitian.
        </Callout>
      </div>

      <div class="toast-demo">
        <p class="eyebrow mb-3">Toast</p>
        <Toast message="Day shuffled." actionLabel="Undo" />
      </div>

      <div class="mt-10 max-w-md">
        <p class="eyebrow mb-3">Bottom sheet</p>
        <BottomSheet title="Swap this meal">
          Three alternatives with similar calories and protein.
        </BottomSheet>
      </div>
    </div>
  </section>

  <section class="section" data-surface="ice">
    <div class="container">
      <SectionHeader
        number="06"
        eyebrow="Structure"
        title="Cards, tags and disclosure"
        intro="Hairlines first. Cards only when a group needs its own surface."
      />

      <div class="two-col">
        <div class="card p-6">
          <div class="flex items-center justify-between gap-4">
            <h3>Besan chilla</h3>
            <span class="tag">North</span>
          </div>
          <p class="small mt-2 text-muted">2 chillas · 160 g · approx. 280 kcal · 14 g protein</p>
          <p class="small mt-4">Gram flour, onion, green chilli. Cook thin on a hot tawa.</p>
          <div class="mt-5 flex gap-4">
            <a href="#" class="text-link small">
              Swap
            </a>
            <a href="#" class="text-link small">
              Recipe
            </a>
          </div>
        </div>

        <div class="stack-sm">
          <div class="flex flex-wrap gap-2">
            <span class="tag">High protein</span>
            <span class="tag">Low GI</span>
            <span class="tag">Jain</span>
            <span class="tag">Under 20 min</span>
          </div>
          <div class="card p-4">
            <p class="eyebrow mb-2">Affiliate disclosure</p>
            <p class="small">
              I earn a commission if you buy through these links, at no extra cost to you. As an
              Amazon Associate I earn from qualifying purchases.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" data-surface="ice">
    <div class="container">
      <SectionHeader
        number="07"
        eyebrow="Data"
        title="Numbers and tables"
        intro="Tabular figures, mono labels. Red marks the target and current value; steel does everything else."
      />

      <div class="stat-grid">
        <StatBlock value="1,840" label="Calories" unit="kcal" />
        <StatBlock value="118" label="Protein" unit="g" />
        <StatBlock value="7" label="Days planned" />
        <StatBlock value="35" label="Fiber" unit="g" note="Target range 25–40 g" />
      </div>

      <div class="mt-10">
        <p class="eyebrow mb-3">Progress · 3px</p>
        <div
          class="progress-track max-w-md"
          role="progressbar"
          aria-valuenow="7"
          aria-valuemin="0"
          aria-valuemax="18"
          aria-label="Questionnaire progress"
        >
          <div class="progress-fill" style="width: 39%"></div>
        </div>
        <p class="label mt-2 text-muted">07 / 18</p>
      </div>

      <div class="mt-10 overflow-x-auto">
        <table class="data-table">
          <caption class="sr-only">Sample workout template</caption>
          <thead>
            <tr>
              <th scope="col">Exercise</th>
              <th scope="col">Sets</th>
              <th scope="col">Reps</th>
              <th scope="col">Rest</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Goblet squat</th>
              <td>3</td>
              <td>8–12</td>
              <td>90 s</td>
            </tr>
            <tr>
              <th scope="row">Incline push-up</th>
              <td>3</td>
              <td>8–12</td>
              <td>90 s</td>
            </tr>
            <tr>
              <th scope="row">One-arm dumbbell row</th>
              <td>3</td>
              <td>10–12</td>
              <td>60 s</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" data-surface="ice">
    <div class="container">
      <SectionHeader
        number="08"
        eyebrow="Navigation"
        title="Tabs and accordion"
        intro="Days of the week, and the FAQ."
      />

      <div class="two-col">
        <div>
          <p class="eyebrow mb-4">Tabs</p>
          <div class="tabs">
            <input type="radio" name="day-tabs" id="tab-mon" checked />
            <label for="tab-mon">MON</label>
            <input type="radio" name="day-tabs" id="tab-tue" />
            <label for="tab-tue">TUE</label>
            <input type="radio" name="day-tabs" id="tab-wed" />
            <label for="tab-wed">WED</label>

            <div class="tab-panel mt-4 border-t border-line pt-4">
              <h3>Monday</h3>
              <p class="small mt-2 text-muted">
                Poha with peanuts, rajma chawal, lauki sabzi and roti.
              </p>
            </div>
            <div class="tab-panel mt-4 border-t border-line pt-4">
              <h3>Tuesday</h3>
              <p class="small mt-2 text-muted">
                Besan chilla, dal with roti, palak paneer and salad.
              </p>
            </div>
            <div class="tab-panel mt-4 border-t border-line pt-4">
              <h3>Wednesday</h3>
              <p class="small mt-2 text-muted">
                Upma with curd, chole with rice, bhindi sabzi and roti.
              </p>
            </div>
          </div>
        </div>

        <div>
          <p class="eyebrow mb-4">Accordion</p>
          <Accordion items={faqs} />
        </div>
      </div>
    </div>
  </section>

  <section class="section" data-surface="ice">
    <div class="container">
      <SectionHeader
        number="09"
        eyebrow="Media and motion"
        title="Photos and movement"
        intro="Photos are real, grayscale and blended into the page. There are no boxes, frames or placeholders."
      />

      <div class="note-grid">
        <div class="card p-6">
          <h3>Photo treatment</h3>
          <p class="small mt-2 text-muted">
            Build-time grayscale, cool tint, high contrast. Cut-out photos fade at the bottom edge;
            photos with a background fade left, bottom, top and right. Never a visible rectangle.
          </p>
        </div>
        <div class="card p-6">
          <h3>Motion</h3>
          <p class="small mt-2 text-muted">
            One kinetic band per page. Headline lines rise once on load. Section reveals use
            scroll-driven CSS. Everything is static with reduced motion.
          </p>
        </div>
      </div>

      <div class="icons-row">
        <p class="eyebrow">Icons</p>
        <div class="icon-set">
          <Icon name="check" />
          <Icon name="alert-triangle" />
          <Icon name="info" />
          <Icon name="stethoscope" />
          <Icon name="arrow-right" />
          <Icon name="play" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .stack-sm {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .two-col {
    display: grid;
    gap: 48px;
  }

  .actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .swatch {
    padding: 12px;
    border-bottom: 1px solid var(--border);
    border-right: 1px solid var(--border);
  }

  .swatch-chip {
    height: 64px;
    border: 1px solid var(--border);
  }

  .swatch-hex {
    color: var(--text-muted);
  }

  .callout-grid {
    display: grid;
    gap: 16px;
  }

  .toast-demo {
    max-width: 420px;
    margin-top: 40px;
  }

  .stat-grid {
    display: grid;
    gap: 32px;
    padding-block: 32px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .note-grid {
    display: grid;
    gap: 16px;
  }

  .icons-row {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
  }

  .icon-set {
    display: flex;
    gap: 16px;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .data-table th,
  .data-table td {
    padding: 12px 16px 12px 0;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .data-table thead th {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--border-strong);
  }

  .data-table tbody th {
    font-weight: 500;
  }

  .data-table td {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 768px) {
    .two-col {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .swatches {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .callout-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .stat-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .note-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
