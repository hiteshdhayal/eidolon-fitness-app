---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import FollowLink from '../components/FollowLink.astro';
import { pageTitle } from '../config/site';
---

<BaseLayout
  title={pageTitle('Page not found')}
  description="That page doesn't exist yet. Head home or build your free diet plan."
  noindex
  hideStickyCta
>
  <section class="notfound" data-surface="obsidian">
    <div class="container">
      <p class="notfound-number" aria-hidden="true">
        404
      </p>

      <h1 class="notfound-title">That page doesn't exist (yet).</h1>
      <p class="notfound-copy">Maybe the link is old, or the page is still being built.</p>

      <div class="notfound-actions">
        <Button href="/plan/" arrow>
          Build my plan
        </Button>
        <Button href="/" variant="secondary">
          Back to home
        </Button>
        <FollowLink variant="text" location="404" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(64px, 10vw, 128px);
    overflow: clip;
  }

  .notfound-number {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 125%;
    font-size: clamp(7rem, 26vw, 20rem);
    line-height: 0.72;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 2px var(--border-strong);
    user-select: none;
  }

  .notfound-title {
    max-width: 16ch;
    margin-top: 32px;
  }

  .notfound-copy {
    max-width: 40ch;
    margin-top: 16px;
    color: var(--text-muted);
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 36px;
  }

  @media (max-width: 767px) {
    .notfound-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .notfound-actions > :global(*) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
