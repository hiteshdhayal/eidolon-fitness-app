---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/content/PageHero.astro';
import FinalCta from '../../components/content/FinalCta.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { getCollection } from 'astro:content';
import { publishedOnly } from '../../lib/content/published';
import { readingTime } from '../../lib/content/readingTime';
import { pageTitle } from '../../config/site';
import '../../styles/content.css';

const picks = publishedOnly(await getCollection('articles'))
  .filter((entry) => entry.data.hasAffiliateLinks)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const dateFmt = new Intl.DateTimeFormat('en-IN', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<BaseLayout
  title={pageTitle('My picks')}
  description="The kit I actually use, with the checks I make before recommending anything."
>
  <PageHero
    eyebrow="Articles · Picks"
    titleBefore="Things I"
    accent="actually"
    titleAfter="recommend."
    sub="Only what I have checked myself. Some links are affiliate links, at no extra cost to you."
  />

  <section class="section" data-surface="ice">
    <div class="container">
      <SectionHeader number="01" eyebrow="Picks" title="Checked first," accent="then linked." rule={false} />

      {picks.length > 0 ? (
        <ul class="ruled-list">
          {picks.map((entry) => (
            <li class="ruled-row">
              <p class="row-date">
                <time datetime={entry.data.date.toISOString()}>
                  {dateFmt.format(entry.data.date)}
                </time>
              </p>
              <div class="row-body">
                <p class="row-title">
                  <a href={`/articles/${entry.id}/`}>{entry.data.title}</a>
                </p>
                <p class="row-dek">{entry.data.description}</p>
                <p class="row-meta">{readingTime(entry.body ?? '')}</p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-state">
          <p>The picks are still being chosen.</p>
        </div>
      )}
    </div>
  </section>

  <FinalCta
    titleBefore="Your plan is"
    accent="2 minutes"
    titleAfter="away."
    location="picks-cta"
  />
</BaseLayout>
