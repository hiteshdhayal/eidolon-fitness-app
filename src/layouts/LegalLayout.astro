---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/content/PageHero.astro';
import FinalCta from '../components/content/FinalCta.astro';
import { pageTitle } from '../config/site';
import { LEGAL_LAST_UPDATED } from '../config/legal';

export interface LegalSection {
  id: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  sections: LegalSection[];
}

const { title, description, sections } = Astro.props;
const slug = title.toLowerCase().replace(/\s+/g, '-');
---

<BaseLayout title={pageTitle(title)} description={description}>
  <PageHero eyebrow="LEGAL" titleBefore="" accent={`${title.toUpperCase()}.`}>
    <p class="legal-updated">Last updated {LEGAL_LAST_UPDATED}</p>
  </PageHero>

  <section class="section legal-body" data-surface="ice">
    <div class="container legal-grid">
      <nav class="legal-toc" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <ol>
          {sections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.label}</a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="legal-content measure">
        <slot />
      </div>
    </div>
  </section>

  <FinalCta
    titleBefore="Your plan is"
    accent="2 minutes"
    titleAfter="away."
    location={`legal-${slug}`}
  />
</BaseLayout>

<style>
  .legal-updated {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--steel-400);
  }

  .legal-body {
    padding-block: clamp(56px, 10vw, 96px);
  }

  .legal-grid {
    display: grid;
    gap: 40px;
  }

  .legal-toc ol {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .legal-toc a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .legal-toc a:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .legal-content :global(h2) {
    margin-top: 48px;
    font-size: 1.375rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .legal-content :global(h2:first-of-type) {
    margin-top: 0;
  }

  .legal-content :global(p) {
    margin-top: 16px;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .legal-content :global(ul) {
    margin-top: 16px;
    padding-left: 1.25em;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .legal-content :global(li + li) {
    margin-top: 8px;
  }

  .legal-content :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .legal-content :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  @media (min-width: 1024px) {
    .legal-grid {
      grid-template-columns: 200px 1fr;
      gap: 64px;
    }

    .legal-toc {
      position: sticky;
      top: calc(var(--header-h) + 32px);
      align-self: start;
    }
  }
</style>
