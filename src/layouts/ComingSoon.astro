---
import BaseLayout from './BaseLayout.astro';
import FollowLink from '../components/FollowLink.astro';
import { site, pageTitle } from '../config/site';

interface Props {
  slug: string;
  title: string;
  copy: string;
}

const { slug, title, copy } = Astro.props;
---

<BaseLayout title={pageTitle(title)} description={copy} noindex>
  <section class="coming" data-surface="obsidian">
    <div class="container coming-inner">
      <p class="eyebrow-row">
        <span class="speed-bar" aria-hidden="true"></span>
        <span class="eyebrow">In the works</span>
      </p>

      <h1 class="display coming-title">{title}</h1>
      <p class="coming-copy">{copy}</p>

      <div class="coming-actions">
        <FollowLink
          variant="primary"
          location={`stub-${slug}`}
          label={`Follow @${site.instagramHandle} for the launch`}
        />
        <a href="/" class="back-link">
          Back to home
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .coming {
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(64px, 12vw, 144px);
    overflow: clip;
  }

  .coming-inner {
    width: 100%;
  }

  .coming-title {
    max-width: 14ch;
    margin-top: 24px;
  }

  .coming-copy {
    max-width: 46ch;
    margin-top: 24px;
    font-size: 1.125rem;
    color: var(--text-muted);
  }

  .coming-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .back-link:hover {
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent);
  }

  @media (max-width: 767px) {
    .coming-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .coming-actions > :global(*) {
      width: 100%;
    }

    .back-link {
      justify-content: center;
    }
  }
</style>
