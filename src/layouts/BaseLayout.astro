---
import { site } from '../config/site';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  hideStickyCta?: boolean;
  overlayHeader?: boolean;
  flushTop?: boolean;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  noindex = false,
  hideStickyCta = false,
  overlayHeader = false,
  flushTop = false,
  ogImage,
  type,
  publishedTime,
  modifiedTime,
} = Astro.props;

const mainClasses = ['site-main', flushTop ? 'site-main-flush' : ''].filter(Boolean).join(' ');
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <Seo
      title={title}
      description={description}
      path={Astro.url.pathname}
      noindex={noindex}
      ogImage={ogImage}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />

    <meta name="theme-color" content="#0B0C0E" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <slot name="head" />

    <link
      rel="preload"
      href="/fonts/archivo-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="low"
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="low"
    />

    {site.umamiWebsiteId && (
      <script
        defer
        src={site.umamiSrc}
        data-website-id={site.umamiWebsiteId}
        data-domains="eidolon.cloud"
        data-exclude-search="true"
        data-exclude-hash="true"
      />
    )}
  </head>
  <body data-surface="ice">
    <a href="#main" class="skip-link">
      Skip to content
    </a>

    <Header overlay={overlayHeader} />

    <main id="main" tabindex="-1" class={mainClasses}>
      <slot />
    </main>

    <Footer />

    {!hideStickyCta && <StickyCta />}

    <script>
      // One small script drives every "plan" CTA using the shared rule table.
      // It only ever changes href and the text of [data-plan-cta-label]; with no
      // JS the link and its default label still work.
      import { planCtaFor, type PlanCtaKind } from '../lib/cta';

      try {
        const hasPlan = !!localStorage.getItem('eidolon:plan:v1');
        const path = location.pathname;

        document.querySelectorAll<HTMLElement>('[data-plan-cta]').forEach((cta) => {
          const kind = (cta.getAttribute('data-plan-cta') ?? 'default') as PlanCtaKind;
          const result = planCtaFor(kind, path, hasPlan);
          const label = cta.querySelector<HTMLElement>('[data-plan-cta-label]');

          if (result.hidden) {
            cta.style.display = 'none';
            return;
          }
          if (result.label && label) label.textContent = result.label;
          if (result.href && cta.tagName === 'A') cta.setAttribute('href', result.href);
        });
      } catch {
        // default labels and links stay
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
  }

  .skip-link:focus {
    position: fixed;
    left: 16px;
    top: 16px;
    z-index: 100;
    padding: 12px 16px;
    background: var(--obsidian-900);
    color: var(--ice-50);
    outline: 2px solid var(--red-400);
    outline-offset: 3px;
  }

  .site-main {
    padding-top: var(--header-h);
  }

  .site-main-flush {
    padding-top: 0;
  }
</style>
